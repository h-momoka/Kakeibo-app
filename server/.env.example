# Copy this file to .env for local development.

# PostgreSQL connection string. On Render + Neon this is provided for you.
DATABASE_URL="postgresql://kakeibo:kakeibo_dev@localhost:5432/kakeibo"

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Your own Anthropic API key. Used ONLY for the receipt-scan endpoint.
ANTHROPIC_API_KEY="sk-ant-..."

# Receipt-scan quota (cost control). Adjust to taste.
RECEIPT_SCAN_HOUSEHOLD_MONTHLY_LIMIT=100
RECEIPT_SCAN_GLOBAL_DAILY_LIMIT=200

PORT=3000
NODE_ENV=development
